package p1;

import java.util.Scanner;

class Product{
	int code;
	String name;
	float price;
	int qty;
	public Product(int a, String b,float c,int d) {
		code=a;
		name=b;
		price=c;
		qty=d;
	}
	void getProduct() {
		System.out.println("===Prodcut Details===");
		System.out.println("Prodcut Code :"+code);
		System.out.println("Product Name :"+name);
		System.out.println("Product Price:"+price);
		System.out.println("Product qty  :"+qty);
	}
}
public class DemoConstructor02 {

	public static void main(String[] args) {
		Scanner s=new Scanner(System.in);
		System.out.println("Enter the Procut-code:");
		int pCode=Integer.parseInt(s.nextLine());
		System.out.println("Enter the Product-name:");
		String pName=s.nextLine();
		System.out.println("Enter the Product-price:");
		float pPrice=s.nextFloat();
		System.out.println("Enter the Product-qty:");
		int pQty=s.nextInt();
		Product obj=new Product(pCode, pName, pPrice, pQty);
		obj.getProduct();
		s.close();
	}

}
